<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!--매우중요! 아래의 디렉토리에 시스템 발송이력 저장됨-->
            <param name="File" value="/data/log_gw/gw/msp_stdout.log"/>
            <fileNamePattern>./logs/gw/msp_stdout.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss} [%thread] %-5level [%class{36}.class] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [%class{36}] - %msg%n</pattern>
        </layout>
    </appender>

    <!--User Access URL Log File-->
    <appender name="eventlog" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <param name="File" value="/data/log_gw/event/mps_event.log"/>
            <fileNamePattern>./logs/event/mps_event.log.%d{yyyy-MM-dd}</fileNamePattern>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{MM/dd HH:mm:ss}, %-5level : %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="kr.msp" additivity="false">
        <level value="debug"/>
        <appender-ref ref="console"/>
    </logger>

    <!-- 3rdparty Loggers -->
    <logger name="org.springframework.core">
        <level value="info" />
    </logger>

    <logger name="org.springframework.beans">
        <level value="info" />
    </logger>

    <logger name="org.springframework.context">
        <level value="info" />
    </logger>

    <logger name="org.springframework.web">
        <level value="info" />
    </logger>

    <logger name="kr.msp.admin.common.interceptor.EventExpirationCheckInterceptor">
        <level value="info"/>
        <appender-ref ref="EVENTLOG"/>
    </logger>

    <!-- Root Logger -->
    <root>
        <priority value="debug" />
        <appender-ref ref="file" />
        <!--<appender-ref ref="FILE" />-->
    </root>
</configuration>
        
