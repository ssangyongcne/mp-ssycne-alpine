<?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE mapper
                PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
                "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ssyc.PushDao">

	<!-- PUSH 수신동의 여부 확인 -->
	<select id="pushRegiInfo" parameterType="Map" resultType="Integer">

		SELECT COUNT(*)
		FROM T_PUSH_USER_INFO
		WHERE
			PSID = #{psid}
		AND
			CUID = #{cuid}

	</select>

</mapper>